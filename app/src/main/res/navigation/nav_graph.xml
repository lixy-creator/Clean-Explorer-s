<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/routingFragment">

    <fragment
        android:id="@+id/routingFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.RoutingFragment"
        android:label="fragment_routing"
        tools:layout="@layout/fragment_routing">
        <action
            android:id="@+id/action_routingFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_routingFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_loginFragment_to_subscribeFragment"
            app:destination="@id/subscribeFragment" />
    </fragment>

    <fragment
        android:id="@+id/subscribeFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.SubscribeFragment"
        android:label="fragment_subscribe"
        tools:layout="@layout/fragment_subscribe">
        <action
            android:id="@+id/action_subscribeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_subscribeFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_accountFragment"
            app:destination="@id/accountFragment" />

        <action
            android:id="@+id/action_homeFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_homeFragment_to_scannerFragment"
            app:destination="@id/scannerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_detailCleanStopFragment"
            app:destination="@id/detailCleanStopFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.AccountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/settingFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/scannerFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.ScannerBarcodeFragment"
        android:label="fragment_scanner_barcode"
        tools:layout="@layout/fragment_scanner_barcode">
        <action
            android:id="@+id/action_scannerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailCleanStopFragment"
        android:name="com.cinnamon.cleanexplorers.view.fragment.DetailCleanStopFragment"
        android:label="fragment_detail_clean_stop"
        tools:layout="@layout/fragment_detail_clean_stop">
        <argument
            android:name="cleanStop"
            app:argType="com.cinnamon.cleanexplorers.api.model.CleanStop" />
        <action
            android:id="@+id/action_detailCleanStopFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <action
        android:id="@+id/action_global_RoutingFragment"
        app:destination="@id/routingFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
</navigation>